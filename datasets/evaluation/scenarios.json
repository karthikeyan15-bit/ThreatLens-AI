[
  {
    "id": "scenario_001",
    "name": "Phishing Email with Malicious Link",
    "description": "Classic credential harvesting email with urgency tactics and malicious link",
    "request": "Analyze this suspicious email: From: security@payroll-services.xyz Subject: URGENT: Payroll Account Suspended - Action Required! Body: Dear Employee, Your payroll account has been suspended due to suspicious activity. You must verify your credentials immediately to restore access. Click here: http://payroll-verify.xyz/login?token=abc123 to confirm your identity. Failure to act within 2 hours will result in permanent account closure. Regards, Payroll Security Team",
    "indicators": {
      "emails": ["security@payroll-services.xyz"],
      "urls": ["http://payroll-verify.xyz/login?token=abc123"],
      "domains": ["payroll-services.xyz", "payroll-verify.xyz"],
      "ips": []
    },
    "reference": {
      "expected_tools": ["email_analyzer", "threat_intel_lookup", "url_analyzer"],
      "expected_calls": [
        {"tool": "email_analyzer", "arguments": {"content": "..."}},
        {"tool": "url_analyzer", "arguments": {"url": "http://payroll-verify.xyz/login?token=abc123"}},
        {"tool": "threat_intel_lookup", "arguments": {"indicator": "payroll-verify.xyz", "indicator_type": "domain"}}
      ],
      "expected_risk": "High",
      "min_expected_evidence": 3,
      "escalation_decision": false,
      "ground_truth_labels": {"email": "phishing", "url": "phishing_url"}
    }
  },
