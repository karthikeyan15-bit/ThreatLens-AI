    "indicators": {
      "emails": ["noreply@microsoft-security-alerts.xyz"],
      "urls": ["https://account-verify-microsoft.xyz/login", "https://security-update-office.xyz/verify"],
      "domains": ["microsoft-security-alerts.xyz", "account-verify-microsoft.xyz", "security-update-office.xyz"],
      "ips": ["45.142.214.89"]
    },
    "reference": {
      "expected_tools": ["email_analyzer", "url_analyzer", "threat_intel_lookup", "ip_analyzer"],
      "expected_calls": [
        {"tool": "email_analyzer", "arguments": {"content": "..."}},
        {"tool": "url_analyzer", "arguments": {"url": "https://account-verify-microsoft.xyz/login"}},
        {"tool": "url_analyzer", "arguments": {"url": "https://security-update-office.xyz/verify"}},
        {"tool": "threat_intel_lookup", "arguments": {"indicator": "account-verify-microsoft.xyz", "indicator_type": "domain"}},
        {"tool": "threat_intel_lookup", "arguments": {"indicator": "security-update-office.xyz", "indicator_type": "domain"}},
        {"tool": "ip_analyzer", "arguments": {"indicator": "45.142.214.89"}},
        {"tool": "threat_intel_lookup", "arguments": {"indicator": "45.142.214.89", "indicator_type": "ip"}}
      ],
      "expected_risk": "Critical",
      "min_expected_evidence": 5,
      "escalation_decision": true,
      "ground_truth_labels": {"email": "phishing", "urls": ["phishing_url", "phishing_url"], "ip": "malicious"}
    }
  },
