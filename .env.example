# ThreatLens AI — Environment Variables
# Copy this file to .env and fill in your values.

# Hugging Face Router Configuration (active LLM provider)
HF_TOKEN=your_huggingface_token_here
HF_MODEL_ID=CohereLabs/tiny-aya-global:cohere
HF_PROVIDER=cohere
HF_BASE_URL=https://router.huggingface.co/v1

# Default generation parameters
HF_TEMPERATURE=0.2
HF_MAX_TOKENS=2048

# Threat Intelligence API Keys (optional — tools return "not_configured" when missing)
URLHAUS_API_KEY=
OPENPHISH_API_KEY=  # OpenPhish Community Feed requires no API key
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Application
DATABASE_PATH=database/threatlens.db
LOG_LEVEL=INFO