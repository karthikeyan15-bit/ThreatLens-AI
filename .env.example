# ThreatLens AI — Environment Variables
# Copy this file to .env and fill in your values.

# Tiny Aya Configuration (Cohere V2 API)
TINY_AYA_API_KEY=your_tiny_aya_api_key_here
TINY_AYA_BASE_URL=https://api.cohere.com/v2
TINY_AYA_MODEL=tiny-aya-global
TINY_AYA_TEMPERATURE=0.2
TINY_AYA_MAX_TOKENS=2048

# Available Tiny Aya Models:
# tiny-aya-global
# tiny-aya-fire
# tiny-aya-earth
# tiny-aya-water

# Threat Intelligence API Keys (optional — tools return "not_configured" when missing)
URLHAUS_API_KEY=
PHishtank_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Application
DATABASE_PATH=database/threatlens.db
LOG_LEVEL=INFO